# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to source control.

# --- Kinde (auth) ---
# Create an application at https://kinde.com
# In your Kinde app settings, set:
#   Allowed callback URLs:           http://localhost:3000/api/auth/kinde_callback
#   Allowed logout redirect URLs:    http://localhost:3000/signed-out
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/signed-out

# --- Database (Neon Postgres) ---
# Get a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Phase D: invites + transactional email ---
# Public origin used to build links inside emails / pasted-to-clipboard
# share strings. Required for /api/invites to return a usable join URL.
# Production should be your custom domain (e.g. https://health.guilduk.com).
# APP_URL=http://localhost:3000

# Resend (https://resend.com) is the transactional email provider used
# for invite delivery. Free tier covers 100 emails/day + 3000/month,
# which is more than enough for invite-driven signup.
#
# When RESEND_API_KEY is missing, every email send is a quiet no-op and
# the UI shows the share-link to copy manually instead. That means you
# can ship the invite flow before paying for / configuring email, then
# flip it on once you've verified a domain in Resend.
#
# EMAIL_FROM is the verified sender. Defaults to Resend's test sender
# `onboarding@resend.dev` when missing, which works for dev but lands in
# spam for real recipients. Set a from address on your own verified
# domain before production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Health <noreply@your-domain.com>
